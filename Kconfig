menuconfig BRIDGES_TEXT_NAV
    bool "Bridges trackball text navigation input processor"
    default y
    depends on ZMK_POINTING
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Convert relative trackball X/Y movement into arrow-key behavior taps.
